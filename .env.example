# Copier ce fichier en .env, puis remplacer les valeurs. Le fichier .env n'est jamais versionné.

# --- Data lake compatible S3 (SeaweedFS dans Docker) ---
S3_ACCESS_KEY=olist_pipeline
S3_SECRET_KEY=remplacez-moi
S3_PORT=8333
S3_ENDPOINT=127.0.0.1:8333
LAKE_BUCKET=olist-lake

# --- Emplacement du lac ---
# s3://...  : le stockage S3 local (ou un vrai S3 / GCS plus tard, sans changer le code)
# un chemin : dossier local, utilisé par l'intégration continue (pas de Docker dans la CI)
LAKE_URI=s3://olist-lake
